{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentsgameframework.dev/schemas/protocol.schema.json",
  "title": "AGF Protocol Message v0",
  "description": "Discriminated union of client/server messages exchanged with a persistent-world backend. Backend implementations (C#/.NET, Node, anything else) MUST treat this schema as the source of truth.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "world.snapshot" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entities"],
          "properties": {
            "elapsed": { "type": "number", "minimum": 0 },
            "entities": {
              "type": "array",
              "items": { "$ref": "#/definitions/snapshotEntity" }
            },
            "lastAcked": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/sequence"
              },
              "description": "Per-playerId: the most recent inbound intent.move sequence the server has applied. Lets the client drop replayed inputs older than the ack and stop accumulating reconciliation error."
            },
            "playerSpeed": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "The integration speed the server uses when applying intent.move. The client's rollback-replay reconciliation reads this so it does not have to hard-code a value."
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "player.join" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playerId"],
          "properties": {
            "playerId": { "$ref": "#/definitions/playerId" },
            "displayName": { "type": "string", "minLength": 1 },
            "recipe": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "S112 KABOOM-MP-RECIPE-SYNC — opaque base64-url-safe blob (e.g. encodeRecipe(CharacterRecipe) for Kaboom Crew). Server treats as untrusted and echoes back in every snapshot as a CharacterRecipe component on the player.<id> entity. 4 KB cap is generous (current recipes encode under 200 bytes)."
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "player.leave" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playerId"],
          "properties": {
            "playerId": { "$ref": "#/definitions/playerId" },
            "reason": {
              "enum": ["disconnect", "timeout", "kicked"]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "intent.move" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playerId", "direction"],
          "properties": {
            "playerId": { "$ref": "#/definitions/playerId" },
            "direction": { "$ref": "#/definitions/vec2" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "description": "S116 KABOOM-MP-PROTOCOL-EXTENSIONS — Sprint B protocol contract per docs/research/kaboom-multiplayer-sprint-b-plan.md §4.",
      "properties": {
        "kind": { "const": "placeBombRequest" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityId", "gx", "gz"],
          "properties": {
            "entityId": { "$ref": "#/definitions/entityId" },
            "gx": { "type": "integer", "minimum": 0 },
            "gz": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "detonateRemoteRequest" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityId"],
          "properties": {
            "entityId": { "$ref": "#/definitions/entityId" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "inputIntent" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityId", "dx", "dz", "tick"],
          "properties": {
            "entityId": { "$ref": "#/definitions/entityId" },
            "dx": { "type": "integer", "minimum": -1, "maximum": 1 },
            "dz": { "type": "integer", "minimum": -1, "maximum": 1 },
            "tick": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "blastEvent" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["originGx", "originGz", "range", "ownerId", "cells"],
          "properties": {
            "originGx": { "type": "integer", "minimum": 0 },
            "originGz": { "type": "integer", "minimum": 0 },
            "range": { "type": "integer", "minimum": 1 },
            "ownerId": { "$ref": "#/definitions/entityId" },
            "cells": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gx", "gz"],
                "properties": {
                  "gx": { "type": "integer", "minimum": 0 },
                  "gz": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "pickupCollected" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityId", "kind", "gx", "gz", "pickerId"],
          "properties": {
            "entityId": { "$ref": "#/definitions/entityId" },
            "kind": { "type": "string", "enum": ["bomb-up", "fire-up", "speed-up", "kick", "remote-detonate", "shield"] },
            "gx": { "type": "integer", "minimum": 0 },
            "gz": { "type": "integer", "minimum": 0 },
            "pickerId": { "$ref": "#/definitions/entityId" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "bomberDied" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityId", "blastOriginGx", "blastOriginGz"],
          "properties": {
            "entityId": { "$ref": "#/definitions/entityId" },
            "blastOriginGx": { "type": "integer", "minimum": 0 },
            "blastOriginGz": { "type": "integer", "minimum": 0 },
            "killerId": { "$ref": "#/definitions/entityId" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "shieldConsumed" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityId", "blastOriginGx", "blastOriginGz"],
          "properties": {
            "entityId": { "$ref": "#/definitions/entityId" },
            "blastOriginGx": { "type": "integer", "minimum": 0 },
            "blastOriginGz": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "roundResolved" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "tally"],
          "properties": {
            "phase": { "type": "string", "enum": ["won", "lost", "draw"] },
            "winnerId": { "$ref": "#/definitions/entityId" },
            "tally": {
              "type": "object",
              "additionalProperties": false,
              "required": ["player", "bot", "draws"],
              "properties": {
                "player": { "type": "integer", "minimum": 0 },
                "bot": { "type": "integer", "minimum": 0 },
                "draws": { "type": "integer", "minimum": 0 }
              }
            },
            "nextRoundAt": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "blockDestroyed" },
        "sequence": { "$ref": "#/definitions/sequence" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gx", "gz"],
          "properties": {
            "gx": { "type": "integer", "minimum": 0 },
            "gz": { "type": "integer", "minimum": 0 },
            "droppedPickupKind": {
              "type": "string",
              "enum": ["bomb-up", "fire-up", "speed-up", "kick", "remote-detonate", "shield"]
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per-connection message number for ordering and replay."
    },
    "playerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-._]*$",
      "minLength": 1,
      "maxLength": 128,
      "description": "S116 KABOOM-MP-PROTOCOL-EXTENSIONS — ECS entity id format (matches snapshotEntity.id below)."
    },
    "vec2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "snapshotEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "components"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-._]*$"
        },
        "components": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
